# Copy to .env and adjust. docker compose reads .env automatically.

# Exact origins allowed to open WebSockets (comma-separated, scheme://host[:port], no trailing slash).
# Production example: https://secrets.example.com
APP_ALLOWED_ORIGINS=http://localhost:8080

# Session lifetime and limits
APP_SESSION_TTL=5m
APP_JOIN_TIMEOUT=10s
APP_MAX_SESSIONS=10000
APP_SESSIONS_PER_MINUTE_PER_IP=30
APP_CONNECTIONS_PER_MINUTE_PER_IP=60

# "native" ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For/-Proto.
# Otherwise clients could spoof their IP and bypass rate limits.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Host binding for the published port. Keep 127.0.0.1 when a local reverse proxy terminates TLS.
HOST_BIND=127.0.0.1
HOST_PORT=8080
